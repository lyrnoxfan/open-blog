<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:orientation="vertical">

    <!-- 悬浮玻璃顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/glass_pill"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?android:attr/borderlessButtonStyle"
            android:text="‹ 返回"
            android:textColor="#5B8DEF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/editor_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="新文章"
            android:textColor="#1F2A44"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?android:attr/borderlessButtonStyle"
            android:text="💾 保存"
            android:textColor="#F472B6"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/glass_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Slug（文件名）"
                android:textColor="#6D7BA0"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/input_slug"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/md_btn"
                android:padding="10dp"
                android:singleLine="true"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="标题"
                android:textColor="#6D7BA0"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/input_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/md_btn"
                android:padding="10dp"
                android:singleLine="true"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="简介"
                android:textColor="#6D7BA0"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/input_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/md_btn"
                android:padding="10dp"
                android:singleLine="true"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="标签"
                android:textColor="#6D7BA0"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/input_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/md_btn"
                android:hint="逗号或空格分隔"
                android:padding="10dp"
                android:singleLine="true"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/check_draft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:text="存为草稿（不公开展示）"
                    android:textColor="#6D7BA0"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_pinned"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="置顶"
                    android:textColor="#6D7BA0"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Markdown 工具栏 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/md_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/md_btn"
                android:elevation="2dp"
                android:text="B"
                android:textColor="#5B8DEF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/md_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/md_btn"
                android:elevation="2dp"
                android:text="H"
                android:textColor="#5B8DEF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/md_quote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/md_btn"
                android:elevation="2dp"
                android:text="❝"
                android:textColor="#5B8DEF" />

            <Button
                android:id="@+id/md_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/md_btn"
                android:elevation="2dp"
                android:text="• ☰"
                android:textColor="#5B8DEF" />

            <Button
                android:id="@+id/md_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/md_btn"
                android:elevation="2dp"
                android:text="&lt;>"
                android:textColor="#5B8DEF" />

            <Button
                android:id="@+id/md_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/md_btn"
                android:elevation="2dp"
                android:text="🔗"
                android:textColor="#5B8DEF" />

            <Button
                android:id="@+id/md_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/md_btn"
                android:elevation="2dp"
                android:text="🖼"
                android:textColor="#5B8DEF" />

            <Button
                android:id="@+id/md_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/md_btn"
                android:elevation="2dp"
                android:text="🎬"
                android:textColor="#F472B6" />
        </LinearLayout>
    </HorizontalScrollView>

    <EditText
        android:id="@+id/input_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/glass_card"
        android:elevation="4dp"
        android:fontFamily="monospace"
        android:gravity="top"
        android:hint="Markdown 正文…"
        android:padding="16dp"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/word_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/glass_pill"
        android:elevation="3dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="#9AA5C4"
        android:textSize="12sp" />
</LinearLayout>
