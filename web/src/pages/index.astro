---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Wisteria from "@/components/Wisteria.astro";
import PostItem from "@/components/PostItem.astro";
import SiteStats from "@/components/SiteStats.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { countWords } from "@/utils/countWords";
import { formatDateZh, toZoned, transitionName } from "@/utils/date";
import { SITE } from "@/config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);

// 置顶逻辑：有置顶文章时，信笺区显示置顶文章；无置顶时显示最新一篇
const pinnedPosts = sortedPosts.filter(post => post.data.pinned);
const hasPinned = pinnedPosts.length > 0;
const featuredPosts = hasPinned ? pinnedPosts : sortedPosts.slice(0, 1);
const listPosts = hasPinned
  ? sortedPosts.filter(p => !p.data.pinned).slice(0, SITE.postPerIndex)
  : sortedPosts.slice(1, SITE.postPerIndex + 1);

// 信纸抬头日期：构建时先写一份，浏览器里再换成当天（访问者本地时区）
const dateline = toZoned(new Date()).format("dddd, MMMM D, YYYY");
---

<Layout>
  <Wisteria />
  <Header />
  <main id="main-content" data-layout="index" class="relative z-10 app-layout">
    <section class="hero rise">
      <p class="dateline" id="dateline">
        {dateline}
      </p>
      <p class="lunar" id="lunar"></p>
      <!-- 单行书写：换行会在「，」后多出一个空格 -->
      <!-- prettier-ignore -->
      <h1 class="hero-title">藤花半架，<br class="sm:hidden" /><span class="hl">闲笔</span>数行。</h1>
      <SiteStats class="mt-4" />
      <p class="hero-aside">
        <a href="/random/" class="text-link">
          随手抽一封
          <IconArrowRight class="size-3.5 rtl:-rotate-180" aria-hidden="true" />
        </a>
      </p>
    </section>

    {featuredPosts.length > 0 && (
      <section aria-label={hasPinned ? "置顶" : "新笺"} class="space-y-8">
        {featuredPosts.map((post, i) => (
          <a
            href={getPath(post.id, post.filePath)}
            class="jian rise"
            style={`--i: ${i + 1}`}
          >
            <span class="seal seal-v" aria-hidden="true">
              {post.data.pinned ? "置顶" : "新笺"}
            </span>
            <span class="jian-kicker">
              {post.data.pinned ? "卷首 ·" : "新近 ·"}
            </span>
            <h2
              class="jian-title"
              style={{ viewTransitionName: transitionName(post.id) }}
            >
              {post.data.title}
            </h2>
            {post.data.description && (
              <p class="jian-desc">{post.data.description}</p>
            )}
            <p class="jian-foot">
              <span>
                <time datetime={post.data.pubDatetime.toISOString()}>
                  {formatDateZh(post.data.pubDatetime, post.data.timezone)}
                </time>
                <span class="mx-1.5" aria-hidden="true">
                  ·
                </span>
                {countWords(post.body ?? "").toLocaleString("zh-CN")} 字
              </span>
              <span class="jian-go">
                展卷
                <IconArrowRight class="rtl:-rotate-180" aria-hidden="true" />
              </span>
            </p>
          </a>
        ))}
      </section>
    )}

    {listPosts.length > 0 && (
      <section class="rise rise-3 mt-12" aria-labelledby="recent-title">
        <div class="section-title">
          <h2 id="recent-title" class="eyebrow">
            近作
          </h2>
          <a href="/archives/" class="text-link">
            书目
            <IconArrowRight
              class="size-3.5 rtl:-rotate-180"
              aria-hidden="true"
            />
          </a>
        </div>
        <ul>
          {listPosts.map(post => (
            <PostItem post={post} as="h3" />
          ))}
        </ul>
      </section>
    )}

    <div class="mt-8 text-center">
      <a href="/posts/" class="btn">
        览全部文集
        <IconArrowRight class="rtl:-rotate-180" aria-hidden="true" />
      </a>
    </div>

    <hr class="wavy" />
    <p class="signature mb-12">
      — {SITE.author}
      <span class="seal seal-outline text-sm" aria-hidden="true">
        {SITE.seal}
      </span>
    </p>
  </main>
</Layout>

<script>
  // 抬头日期换成访问当天；再添一行农历（浏览器不支持农历时不显示）
  const now = new Date();
  const el = document.getElementById("dateline");
  if (el) {
    el.textContent = new Intl.DateTimeFormat("en-US", {
      weekday: "long",
      year: "numeric",
      month: "long",
      day: "numeric",
    }).format(now);
  }
  const lunar = document.getElementById("lunar");
  if (lunar) {
    try {
      const text = new Intl.DateTimeFormat("zh-CN-u-ca-chinese", {
        dateStyle: "long",
      })
        .format(now)
        .replace(/^\d+/, "");
      if (/年/.test(text) && !/\d/.test(text)) {
        lunar.textContent = text.replace("年", "年 ");
      }
    } catch {
      /* 不支持农历历法时保持空白 */
    }
  }
  // 从首页进入文章后，「返回」回到首页
  sessionStorage.setItem("backUrl", "/");
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: 0.75rem 2.5rem;
  }
  @media (width >= 640px) {
    .hero {
      padding-top: 1.5rem;
    }
  }
  .hero-aside {
    margin-top: 0.85rem;
    font-size: 0.875rem;
  }
  .hero-title {
    margin-top: 1rem;
    font-size: clamp(1.75rem, 1.45rem + 1.4vw, 2.25rem);
    font-weight: 600;
    line-height: 1.55;
    letter-spacing: 0.04em;
  }
</style>
