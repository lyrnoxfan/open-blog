---
/**
 * 随手抽一封：构建时把全部文章路径序列化进页面，
 * 客户端 Math.random 选一篇并 location.replace 跳过去。
 * 不留历史——刷新即换一篇。
 */
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import { SITE } from "@/config";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";

const posts = getSortedPosts(
  await getCollection("blog", ({ data }) => !data.draft)
);
const slugs = posts.map(p => getPath(p.id, p.filePath));
---

<Layout title={`随手抽一封 | ${SITE.title}`}>
  <Header />
  <main
    id="main-content"
    class="app-layout flex flex-1 items-center justify-center pb-12"
  >
    <div class="rand-card rise w-full max-w-sm px-6 pt-12 pb-9 text-center">
      <span class="rand-mark" aria-hidden="true">≐</span>
      <p class="font-hand text-2xl text-seal">随手抽一封 ·</p>
      <h1 class="mt-3 text-2xl font-semibold text-ink">正在抽取…</h1>
      <p class="mt-4 font-serif text-lg text-ink-soft">
        从一摞信里，任意取一封。
      </p>
      <p class="mt-1 text-sm text-ink-faint" id="rand-fallback" hidden>
        若久不跳转，<a href="/posts/" class="text-link">回文集翻翻</a>。
      </p>
    </div>
  </main>
</Layout>

<script is:inline define:vars={{ slugs }}>
  (function () {
    if (!Array.isArray(slugs) || slugs.length === 0) {
      const f = document.getElementById("rand-fallback");
      if (f) f.hidden = false;
      return;
    }
    const pick = slugs[Math.floor(Math.random() * slugs.length)];
    // replace：不留本页历史，浏览器后退直接跳过 random
    location.replace(pick);
  })();
</script>

<style>
  .rand-card {
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-md);
  }
  .rand-mark {
    display: inline-block;
    margin-bottom: 0.5rem;
    color: var(--wisteria);
    font-family: var(--ff-serif);
    font-size: 2.5rem;
    line-height: 1;
    animation: rand-pulse 2.4s var(--ease-soft) infinite;
  }
  @keyframes rand-pulse {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.08);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rand-mark {
      animation: none;
    }
  }
</style>