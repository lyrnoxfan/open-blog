---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <Header />

  <main
    id="main-content"
    class="flex app-layout flex-1 items-center justify-center"
  >
    <div
      class="mb-14 flex flex-col items-center justify-center px-4 text-center"
    >
      <h1 class="text-8xl font-bold text-accent">404</h1>
      <p class="mt-4 text-xl font-medium sm:text-2xl">页面未找到</p>
      <p class="mt-2 text-sm opacity-60">你访问的页面不存在或已被移动</p>
      <LinkButton href="/" class="my-6 btn-pill btn-pill-hover">
        返回首页
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
