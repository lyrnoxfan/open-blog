---
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconRss from "@/assets/icons/IconRss.svg";
import { SITE } from "@/config";

const { pathname } = Astro.url;
const aboutActive = pathname.replace(/\/$/, "") === "/about";
---

<a
  id="skip-to-content"
  href="#main-content"
  class="fixed start-4 -top-full z-[60] rounded-full bg-surface px-4 py-2 text-wisteria shadow-[var(--shadow-md)] focus:top-4"
>
  径至正文
</a>
<header class="site-head app-layout">
  <a href="/" class="brand" aria-label={`${SITE.seal} · ${SITE.title}，返回首页`}>
    <span class="seal">{SITE.seal}</span>
    <span class="brand-name">
      My Blog<span class="brand-sub"> · 藤笺</span>
    </span>
  </a>
  <nav aria-label="站点" class="site-nav">
    <a
      href="/about/"
      class:list={["site-link", { "is-on": aboutActive }]}
      aria-current={aboutActive ? "page" : undefined}
    >
      关于
    </a>
    <a href="/rss.xml" class="site-icon site-rss" title="订阅">
      <IconRss class="size-5" aria-hidden="true" />
      <span class="sr-only">订阅</span>
    </a>
    {SITE.lightAndDarkMode && (
      <button
        type="button"
        id="theme-btn"
        class="site-icon relative"
        title="昼夜互换"
        aria-label="切换昼夜模式"
        aria-live="polite"
      >
        <IconMoon class="absolute size-5 scale-100 rotate-0 transition-transform duration-300 dark:scale-0 dark:-rotate-90" />
        <IconSunHigh class="absolute size-5 scale-0 rotate-90 transition-transform duration-300 dark:scale-100 dark:rotate-0" />
      </button>
    )}
  </nav>
</header>

<style>
  .site-head {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
  }
  @media (width >= 640px) {
    .site-head {
      padding-block: 1.5rem;
    }
  }
  .brand {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.65rem;
    border-radius: 0.5rem;
  }
  .brand .seal {
    transform-origin: 70% 70%;
    transition: transform 300ms var(--ease-out);
  }
  .brand:hover .seal {
    transform: rotate(0deg) scale(1.06);
  }
  .brand-name {
    color: var(--ink);
    font-family: var(--ff-serif);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .brand-sub {
    color: var(--ink-soft);
    font-weight: 500;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.9375rem;
  }
  .site-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    border-radius: 999px;
    padding-inline: 0.85rem;
    color: var(--ink-soft);
    letter-spacing: 0.06em;
    transition:
      color var(--dur) ease,
      background-color var(--dur) ease;
  }
  .site-link:hover,
  .site-link.is-on {
    color: var(--wisteria);
  }
  .site-link.is-on {
    background: var(--wisteria-soft);
  }
  .site-icon {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    color: var(--ink-soft);
    transition:
      color var(--dur) ease,
      background-color var(--dur) ease;
  }
  .site-icon:hover {
    background: var(--paper-deep);
    color: var(--wisteria);
  }
  .site-rss {
    display: none;
  }
  @media (width >= 640px) {
    .site-rss {
      display: inline-flex;
    }
  }
</style>
