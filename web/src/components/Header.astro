---
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconRss from "@/assets/icons/IconRss.svg";
import { SITE } from "@/config";

const { pathname } = Astro.url;
const aboutActive = pathname.replace(/\/$/, "") === "/about";
---

<a
  id="skip-to-content"
  href="#main-content"
  class="fixed start-4 -top-full z-[60] rounded-full bg-surface px-4 py-2 text-wisteria shadow-[var(--shadow-md)] focus:top-4"
>
  跳转到内容
</a>

<header class="relative z-10 app-layout">
  <div class="flex items-center justify-between gap-4 py-4 sm:py-6">
    <a
      href="/"
      class="group flex min-h-11 items-center gap-2.5 rounded-lg"
      aria-label={`${SITE.title}，返回首页`}
    >
      <span class="seal transition-transform duration-300 group-hover:rotate-0">
        {SITE.seal}
      </span>
      <span class="font-serif text-lg font-semibold tracking-wide text-ink">
        lyrnox<span class="font-normal text-ink-soft">'s blog</span>
      </span>
    </a>

    <nav aria-label="站点" class="flex items-center gap-1 text-[0.9375rem]">
      <a
        href="/about/"
        class:list={[
          "inline-flex min-h-11 items-center rounded-full px-3 transition-colors",
          aboutActive ? "text-wisteria" : "text-ink-soft hover:text-wisteria",
        ]}
        aria-current={aboutActive ? "page" : undefined}
      >
        关于
      </a>
      <a
        href="/rss.xml"
        class="hidden size-11 items-center justify-center rounded-full text-ink-soft transition-colors hover:text-wisteria sm:inline-flex"
        title="RSS 订阅"
      >
        <IconRss class="size-5" aria-hidden="true" />
        <span class="sr-only">RSS 订阅</span>
      </a>
      {
        SITE.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="relative inline-flex size-11 items-center justify-center rounded-full text-ink-soft transition-colors hover:text-wisteria"
            title="切换浅色 / 深色"
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="absolute size-5 scale-100 rotate-0 transition-transform duration-300 dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute size-5 scale-0 rotate-90 transition-transform duration-300 dark:scale-100 dark:rotate-0" />
          </button>
        )
      }
    </nav>
  </div>
</header>
