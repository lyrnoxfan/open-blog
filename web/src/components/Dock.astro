---
const pathname = Astro.url.pathname;
const homeActive = pathname === "/";
const editorActive = pathname === "/lyrnox" || pathname.startsWith("/lyrnox/");
---

<nav
  id="app-dock"
  aria-label="快捷导航"
  class="fixed bottom-[calc(22px+env(safe-area-inset-bottom,0px))] left-1/2 z-40 -translate-x-1/2 glass-pill"
>
  <div class="flex items-center gap-1 px-3 py-2">
    <a
      href="/"
      class:list={[
        "flex items-center gap-1.5 whitespace-nowrap rounded-full px-3 py-2 text-[15px] font-medium transition-all duration-200",
        homeActive
          ? "bg-accent/10 text-accent"
          : "text-foreground/65 hover:bg-muted hover:text-accent",
      ]}
      aria-current={homeActive ? "page" : undefined}
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path
          d="M3 10.5 12 3l9 7.5V21a1 1 0 0 1-1 1h-5v-7h-6v7H4a1 1 0 0 1-1-1z"
        ></path></svg
      >
      首页
    </a>
    <a
      href="/lyrnox"
      class:list={[
        "flex items-center gap-1.5 whitespace-nowrap rounded-full px-3 py-2 text-[15px] font-medium transition-all duration-200",
        editorActive
          ? "bg-accent/10 text-accent"
          : "text-foreground/65 hover:bg-muted hover:text-accent",
      ]}
      aria-current={editorActive ? "page" : undefined}
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="M17 3a2.8 2.8 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5z"></path></svg
      >
      写文章
    </a>
  </div>
</nav>
