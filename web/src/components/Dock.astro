---
/**
 * 底部 Dock：全站唯一的主导航（手机拇指可达；桌面同样适用）。
 * 下滑阅读时自动收起，上滑或停在页面底部时出现。
 */
import IconHome from "@/assets/icons/IconHome.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconHash from "@/assets/icons/IconHash.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconPen from "@/assets/icons/IconPen.svg";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const first = path.split("/")[1] ?? "";

const items = [
  { href: "/", label: "首页", icon: IconHome, active: path === "/" },
  {
    href: "/posts/",
    label: "文章",
    icon: IconArchive,
    active: first === "posts",
  },
  { href: "/tags/", label: "标签", icon: IconHash, active: first === "tags" },
  {
    href: "/search/",
    label: "搜索",
    icon: IconSearch,
    active: first === "search",
  },
];
const writeActive = first === "lyrnox";
---

<nav id="app-dock" class="dock" aria-label="主导航">
  <ul class="dock-list">
    {
      items.map(item => (
        <li>
          <a
            href={item.href}
            class="dock-item"
            aria-current={item.active ? "page" : undefined}
          >
            <item.icon class="dock-icon" aria-hidden="true" />
            <span>{item.label}</span>
          </a>
        </li>
      ))
    }
    <li class="dock-sep" aria-hidden="true"></li>
    <li>
      <a
        href="/lyrnox"
        class="dock-item dock-write"
        aria-current={writeActive ? "page" : undefined}
      >
        <IconPen class="dock-icon" aria-hidden="true" />
        <span>写文章</span>
      </a>
    </li>
  </ul>
</nav>

<script>
  function initDock() {
    const dock = document.getElementById("app-dock");
    if (!dock || dock.dataset.ready) return;
    dock.dataset.ready = "1";
    let lastY = window.scrollY;
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      const nearBottom =
        window.innerHeight + y >= document.documentElement.scrollHeight - 80;
      const hide = y > lastY + 4 && y > 240 && !nearBottom;
      const show = y < lastY - 4 || nearBottom || y < 240;
      if (hide) dock.dataset.hidden = "true";
      else if (show) delete dock.dataset.hidden;
      lastY = y;
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    // 键盘聚焦到 Dock 时总是显示
    dock.addEventListener("focusin", () => delete dock.dataset.hidden);
  }
  initDock();
</script>

<style>
  .dock {
    position: fixed;
    left: 50%;
    bottom: calc(0.875rem + var(--safe-bottom));
    z-index: 40;
    transform: translateX(-50%);
    border: 1px solid var(--rule);
    border-radius: 1.375rem;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    box-shadow: var(--shadow-lg);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
    transition:
      transform 320ms var(--ease-out),
      opacity 320ms var(--ease-out);
  }
  .dock[data-hidden] {
    transform: translate(-50%, calc(100% + 1.5rem));
    opacity: 0;
  }
  .dock-list {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    padding: 0.3rem;
  }
  .dock-item {
    display: flex;
    min-width: 3.5rem;
    min-height: 3.25rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.125rem;
    border-radius: 1.0625rem;
    padding: 0.25rem 0.5rem;
    color: var(--ink-soft);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    transition:
      color var(--dur) ease,
      background-color var(--dur) ease;
  }
  .dock-item:hover {
    color: var(--wisteria);
  }
  .dock-item[aria-current="page"] {
    background: var(--wisteria-soft);
    color: var(--wisteria);
  }
  .dock-icon {
    width: 1.375rem;
    height: 1.375rem;
  }
  .dock-sep {
    width: 1px;
    height: 1.75rem;
    margin-inline: 0.2rem;
    background: var(--rule-strong);
  }
  .dock-write {
    color: var(--seal);
  }
  .dock-write:hover {
    color: var(--seal);
    background: var(--seal-soft);
  }
  .dock-write[aria-current="page"] {
    background: var(--seal-soft);
    color: var(--seal);
  }
  @media (width >= 640px) {
    .dock-item {
      min-height: 2.75rem;
      flex-direction: row;
      gap: 0.4rem;
      padding-inline: 0.875rem;
      font-size: 0.875rem;
    }
    .dock-icon {
      width: 1.125rem;
      height: 1.125rem;
    }
  }
</style>
