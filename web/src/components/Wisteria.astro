---
/**
 * 紫藤：首页顶部垂下的花穗 + 零星落瓣。
 * - 花穗是构建时用固定种子生成的 SVG（每次构建同一棵），零图片素材。
 * - 颜色全部取自令牌 --w0…--w4 / --leaf，深浅色模式自动切换。
 * - 摆动是纯 CSS；落瓣是轻量 canvas，只在可见时运行。
 * - prefers-reduced-motion 下两者都静止。
 */
type Props = { class?: string };
const { class: className = "" } = Astro.props;

// mulberry32：小而稳定的伪随机数
function rng(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(20261017);
const W = 1000;
const H = 150;

// 枝条：沿顶边微微起伏
const branch = `M-20 10 C 180 26, 320 2, 480 14 S 780 4, 1020 16`;

type Flower = { x: number; y: number; r: number; tone: number; rot: number };
type Raceme = {
  x: number;
  y: number;
  len: number;
  flowers: Flower[];
  delay: number;
  dur: number;
};

// 花穗分布：中右密、两端疏，像一段从页顶垂下的花帘
const anchors = [
  40, 120, 230, 330, 420, 500, 565, 625, 680, 735, 790, 845, 900, 955,
];
const racemes: Raceme[] = anchors.map((ax, i) => {
  const x = ax + (rand() - 0.5) * 18;
  const y = 10 + Math.sin(x / 160) * 5;
  const len = (ax < 300 ? 45 : 60) + rand() * (ax < 300 ? 40 : 70);
  const count = Math.round(len / 5.2);
  const flowers: Flower[] = [];
  for (let k = 0; k < count; k++) {
    const t = k / (count - 1); // 0 = 花梗，1 = 花尖
    const width = (1 - t * 0.78) * 11; // 越往下越窄
    const side = k % 2 === 0 ? -1 : 1;
    flowers.push({
      x: side * width * (0.35 + rand() * 0.45) + (rand() - 0.5) * 2,
      y: 6 + t * len,
      r: 4.6 - t * 2.6 + rand() * 0.6,
      tone: Math.min(4, Math.floor(t * 4.2 + rand() * 0.8)),
      rot: (rand() - 0.5) * 60,
    });
  }
  return {
    x,
    y,
    len,
    flowers,
    delay: -rand() * 6,
    dur: 5.5 + rand() * 3.5 + (i % 3),
  };
});

// 羽状复叶：几片小叶挂在枝上
const leaves = Array.from({ length: 16 }, () => {
  const x = rand() * 1000;
  return {
    x,
    y: 12 + Math.sin(x / 160) * 5 + rand() * 6,
    rot: 20 + rand() * 140,
    s: 0.7 + rand() * 0.5,
  };
});
---

<div class:list={["wisteria", className]} aria-hidden="true">
  <svg
    class="wisteria-svg"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="xMidYMin slice"
  >
    <path d={branch} class="w-branch"></path>
    {
      leaves.map(l => (
        <g
          transform={`translate(${l.x.toFixed(1)} ${l.y.toFixed(1)}) rotate(${l.rot.toFixed(0)}) scale(${l.s.toFixed(2)})`}
        >
          <path class="w-leaf" d="M0 0 C 6 -5, 16 -5, 24 0 C 16 5, 6 5, 0 0Z" />
        </g>
      ))
    }
    {
      racemes.map(r => (
        <g transform={`translate(${r.x.toFixed(1)} ${r.y.toFixed(1)})`}>
          <g
            class="w-raceme"
            style={`animation-delay:${r.delay.toFixed(2)}s;animation-duration:${r.dur.toFixed(2)}s`}
          >
            <path
              class="w-stem"
              d={`M0 0 Q 2 ${(r.len / 2).toFixed(0)} 0 ${r.len.toFixed(0)}`}
            />
            {r.flowers.map(f => (
              <ellipse
                cx={f.x.toFixed(1)}
                cy={f.y.toFixed(1)}
                rx={f.r.toFixed(2)}
                ry={(f.r * 0.72).toFixed(2)}
                transform={`rotate(${f.rot.toFixed(0)} ${f.x.toFixed(1)} ${f.y.toFixed(1)})`}
                class={`w-t${f.tone}`}
              />
            ))}
          </g>
        </g>
      ))
    }
  </svg>
  <canvas class="wisteria-petals"></canvas>
</div>

<script>
  // 落瓣：最多 14 片，仅在横幅可见且未开启「减少动态效果」时运行
  function initPetals() {
    const canvas =
      document.querySelector<HTMLCanvasElement>(".wisteria-petals");
    if (!canvas || canvas.dataset.ready) return;
    canvas.dataset.ready = "1";
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let W = 0;
    let H = 0;
    let raf = 0;
    let running = false;
    let color = "#9a82c9";

    type Petal = {
      x: number;
      y: number;
      s: number;
      vy: number;
      vx: number;
      rot: number;
      vr: number;
      sway: number;
      a: number;
    };
    let petals: Petal[] = [];

    const make = (init: boolean): Petal => ({
      x: W * (0.45 + Math.random() * 0.55),
      y: init ? Math.random() * H : -10,
      s: 2.5 + Math.random() * 3,
      vy: 0.25 + Math.random() * 0.45,
      vx: -0.15 + Math.random() * 0.1,
      rot: Math.random() * Math.PI * 2,
      vr: (Math.random() - 0.5) * 0.03,
      sway: Math.random() * Math.PI * 2,
      a: 0.35 + Math.random() * 0.4,
    });

    const resize = () => {
      const r = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = r.width;
      H = r.height;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      color =
        getComputedStyle(document.documentElement)
          .getPropertyValue("--w2")
          .trim() || color;
    };

    const step = () => {
      if (!running) return;
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = color;
      for (const p of petals) {
        p.sway += 0.014;
        p.x += p.vx + Math.sin(p.sway) * 0.25;
        p.y += p.vy;
        p.rot += p.vr;
        if (p.y > H + 10 || p.x < -10) Object.assign(p, make(false));
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rot);
        ctx.globalAlpha = p.a * Math.max(0, 1 - p.y / H);
        ctx.beginPath();
        ctx.ellipse(0, 0, p.s, p.s * 0.6, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }
      raf = requestAnimationFrame(step);
    };

    resize();
    petals = Array.from({ length: Math.min(14, Math.floor(W / 40)) }, () =>
      make(true)
    );

    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !running) {
        running = true;
        raf = requestAnimationFrame(step);
      } else if (!entry.isIntersecting) {
        running = false;
        cancelAnimationFrame(raf);
      }
    }).observe(canvas);

    let t: number | undefined;
    window.addEventListener("resize", () => {
      clearTimeout(t);
      t = window.setTimeout(resize, 200);
    });
    // 切换主题时更新花瓣颜色
    new MutationObserver(resize).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  }

  initPetals();
</script>

<style>
  .wisteria {
    position: relative;
    height: 104px;
    margin-bottom: -2.25rem;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
  @media (width >= 640px) {
    .wisteria {
      height: 132px;
      margin-bottom: -3rem;
    }
  }
  .wisteria-svg,
  .wisteria-petals {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .w-branch {
    fill: none;
    stroke: var(--ink-faint);
    stroke-width: 2.2;
    stroke-linecap: round;
    opacity: 0.55;
  }
  .w-stem {
    fill: none;
    stroke: var(--leaf);
    stroke-width: 1;
    opacity: 0.6;
  }
  .w-leaf {
    fill: var(--leaf);
    opacity: 0.5;
  }
  .w-t0 {
    fill: var(--w0);
  }
  .w-t1 {
    fill: var(--w1);
  }
  .w-t2 {
    fill: var(--w2);
  }
  .w-t3 {
    fill: var(--w3);
  }
  .w-t4 {
    fill: var(--w4);
  }
  ellipse {
    opacity: 0.88;
  }
  .w-raceme {
    transform-box: view-box;
    transform-origin: 0 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .w-raceme {
      animation: sway ease-in-out infinite alternate;
    }
  }
  @keyframes sway {
    from {
      transform: rotate(-2.2deg);
    }
    to {
      transform: rotate(2.2deg);
    }
  }
</style>
