---
/**
 * 紫藤：首页顶部垂下的一架花帘。
 * - 每次打开都用新的随机种子在浏览器里长出一架；地址加 ?seed=数字 可复现同一架
 *   （当前种子写在 .wisteria 的 data-seed 上）。
 * - 藤蔓、复叶、花穗全是 SVG，零图片素材；颜色取自令牌 --w0…--w4 / --bud / --vine / --leaf，
 *   昼夜自动切换。
 * - 风：平时轻摆；隔一阵来一阵风，花穗顺风偏、落几片花瓣。点一下，附近的花穗会晃、会掉瓣。
 * - 只在横幅可见、页面在前台时运行；「减少动态效果」下静止、不落瓣。
 */
type Props = { class?: string };
const { class: className = "" } = Astro.props;
---

<div class:list={["wisteria", className]} aria-hidden="true">
  <svg class="wisteria-svg" xmlns="http://www.w3.org/2000/svg"></svg>
  <canvas class="wisteria-petals"></canvas>
</div>

<script>
  const NS = "http://www.w3.org/2000/svg";

  /** mulberry32：小而稳定的伪随机数 */
  function mulberry32(seed: number) {
    let a = seed >>> 0;
    return () => {
      a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  type Raceme = {
    g: SVGGElement;
    x: number;
    y: number;
    len: number;
    depth: number;
    amp: number;
    w: number;
    phase: number;
    gust: number;
    angle: number;
    vel: number;
  };
  type Leaf = {
    g: SVGGElement;
    x: number;
    y: number;
    base: number;
    phase: number;
    w: number;
  };
  type Petal = {
    x: number;
    y: number;
    s: number;
    vy: number;
    sway: number;
    vs: number;
    rot: number;
    vr: number;
    flip: number;
    vf: number;
    a: number;
    c: string;
  };
  type Flower = {
    x: number;
    y: number;
    r: number;
    z: number;
    t: number;
    tilt: number;
    tone: number;
  };

  const f1 = (n: number) => n.toFixed(1);

  function add<K extends keyof SVGElementTagNameMap>(
    parent: Element,
    tag: K,
    attrs: Record<string, string | number>
  ): SVGElementTagNameMap[K] {
    const node = document.createElementNS(NS, tag);
    for (const k in attrs) node.setAttribute(k, String(attrs[k]));
    parent.appendChild(node);
    return node;
  }

  function initWisteria() {
    const root = document.querySelector<HTMLElement>(".wisteria");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "1";
    const svg = root.querySelector<SVGSVGElement>(".wisteria-svg");
    const canvas = root.querySelector<HTMLCanvasElement>(".wisteria-petals");
    if (!svg || !canvas) return;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // 种子：默认每次随机；?seed=123 可复现
    const param = new URLSearchParams(location.search).get("seed");
    const seed =
      param && /^\d{1,10}$/.test(param)
        ? Number(param) >>> 0
        : (Math.random() * 4294967296) >>> 0;
    root.dataset.seed = String(seed);

    let W = 0;
    let H = 0;
    let racemes: Raceme[] = [];
    let leaves: Leaf[] = [];

    /* ================= 生长 ================= */
    const build = () => {
      const rect = root.getBoundingClientRect();
      W = Math.max(1, Math.round(rect.width));
      H = Math.max(1, Math.round(rect.height));
      const rand = mulberry32(seed);
      const rr = (a: number, b: number) => a + (b - a) * rand();

      svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
      svg.replaceChildren();
      racemes = [];
      leaves = [];

      // —— 老藤：沿页顶起伏，两股缠绕 ——
      const step = 150;
      const pts: [number, number][] = [];
      for (let x = -40; x <= W + 40 + step; x += step) {
        pts.push([x + rr(-20, 20), rr(5, 15)]);
      }
      const vineY = (x: number) => {
        for (let i = 0; i < pts.length - 1; i++) {
          const [x0, y0] = pts[i];
          const [x1, y1] = pts[i + 1];
          if (x >= x0 && x <= x1) {
            const t = (x - x0) / (x1 - x0);
            return y0 + (y1 - y0) * (0.5 - Math.cos(t * Math.PI) / 2);
          }
        }
        return 10;
      };
      const smooth = (offset: (i: number) => number) => {
        let d = `M${f1(pts[0][0])} ${f1(pts[0][1] + offset(0))}`;
        for (let i = 0; i < pts.length - 1; i++) {
          const [x0, y0] = pts[i];
          const [x1, y1] = pts[i + 1];
          const mx = (x0 + x1) / 2;
          d += ` C${f1(mx)} ${f1(y0 + offset(i))} ${f1(mx)} ${f1(y1 + offset(i + 1))} ${f1(x1)} ${f1(y1 + offset(i + 1))}`;
        }
        return d;
      };

      const backLayer = add(svg, "g", { class: "w-back" });
      const vineLayer = add(svg, "g", { class: "w-vines" });
      const leafLayer = add(svg, "g", { class: "w-leaves" });
      const frontLayer = add(svg, "g", { class: "w-front" });

      add(vineLayer, "path", { class: "w-vine", d: smooth(() => 0) });
      add(vineLayer, "path", {
        class: "w-vine2",
        d: smooth(i => (i % 2 ? 3.2 : -2.6)),
      });
      // 卷须
      for (let i = 0, n = Math.max(2, Math.round(W / 170)); i < n; i++) {
        const x = rr(0, W);
        const y = vineY(x);
        const dir = rand() > 0.5 ? 1 : -1;
        const r = rr(4, 7);
        add(vineLayer, "path", {
          class: "w-tendril",
          d: `M${f1(x)} ${f1(y)} q${f1(dir * r * 1.6)} ${f1(r * 0.4)} ${f1(dir * r * 1.4)} ${f1(r * 1.8)} q${f1(-dir * r * 0.2)} ${f1(r * 0.9)} ${f1(-dir * r * 0.9)} ${f1(r * 0.5)}`,
        });
      }

      // —— 一串花穗：花梗上螺旋排开的蝶形小花，上开下苞 ——
      const raceme = (
        parent: Element,
        x: number,
        len: number,
        depth: number
      ) => {
        const y = vineY(x) + rr(-1, 2);
        const g = add(parent, "g", {
          transform: `translate(${f1(x)} ${f1(y)})`,
        });
        const bend = rr(-0.08, 0.08) * len;
        add(g, "path", {
          class: "w-stem",
          d: `M0 0 Q${f1(bend)} ${f1(len / 2)} ${f1(bend * 0.4)} ${f1(len)}`,
        });
        const n = Math.max(10, Math.round(len / (2.7 * depth)));
        const halfW = Math.min(9, Math.max(5, len * 0.075)) * depth;
        const rTop = Math.min(6.4, Math.max(4.4, len * 0.058)) * depth;
        const turn = rr(0, Math.PI * 2);
        const flowers: Flower[] = [];
        for (let k = 0; k < n; k++) {
          const t = k / (n - 1);
          const sx = 2 * (1 - t) * t * bend + t * t * bend * 0.4;
          const a = turn + k * 2.39996; // 黄金角：小花绕花梗螺旋
          const wid = halfW * Math.pow(1 - t, 0.9) * rr(0.8, 1.1) + 1;
          flowers.push({
            x: sx + Math.cos(a) * wid,
            y: 4 + t * (len - 4) + rr(-0.8, 0.8),
            r: rTop * (1 - 0.55 * t) * rr(0.88, 1.1),
            z: Math.sin(a),
            t,
            tilt: Math.cos(a) * 28 + rr(-14, 14),
            tone: Math.min(4, Math.floor(1 + t * 3.2 + rr(0, 0.8))),
          });
        }
        flowers.sort((p, q) => p.z - q.z); // 背面的先画
        for (const fl of flowers) {
          const far = fl.z < -0.25 ? " w-far" : "";
          const rot = `rotate(${f1(fl.tilt)} ${f1(fl.x)} ${f1(fl.y)})`;
          if (fl.t > 0.86) {
            add(g, "ellipse", {
              class: `w-bud${far}`,
              cx: f1(fl.x),
              cy: f1(fl.y),
              rx: f1(fl.r * 0.62),
              ry: f1(fl.r * 0.82),
              transform: rot,
            });
            continue;
          }
          // 旗瓣（大、浅）+ 龙骨瓣（小、深）
          add(g, "ellipse", {
            class: `w-t${fl.tone}${far}`,
            cx: f1(fl.x),
            cy: f1(fl.y - fl.r * 0.15),
            rx: f1(fl.r),
            ry: f1(fl.r * 0.8),
            transform: rot,
          });
          add(g, "ellipse", {
            class: `w-t${Math.max(0, fl.tone - 2)} w-keel${far}`,
            cx: f1(fl.x),
            cy: f1(fl.y + fl.r * 0.42),
            rx: f1(fl.r * 0.5),
            ry: f1(fl.r * 0.36),
            transform: rot,
          });
        }
        racemes.push({
          g,
          x,
          y,
          len,
          depth,
          amp: rr(1.2, 2.4) / depth,
          w: rr(0.55, 0.95),
          phase: rr(0, Math.PI * 2),
          gust: rr(5, 9) * Math.min(1.4, len / 110),
          angle: 0,
          vel: 0,
        });
      };

      // 花帘：两端长、中间短，像给页面挂了一道帘
      const lengthAt = (x: number, depth: number) => {
        const e = Math.min(1, Math.max(0, Math.min(x, W - x) / (W / 2)));
        const edge = Math.pow(1 - e, 1.4);
        return (
          H * (0.36 + 0.56 * edge) * rr(0.62, 1.1) * (depth < 1 ? 0.85 : 1)
        );
      };
      const gap = Math.min(54, Math.max(34, W / 11));
      // 成簇：多数挨得近，偶尔空出一段，像真的花架而不是一排流苏
      const stride = () => gap * (rand() < 0.22 ? rr(1.5, 2.2) : rr(0.55, 1));
      for (let x = rr(0, gap); x < W + gap / 2; x += stride()) {
        raceme(backLayer, x, lengthAt(x, 0.72), 0.72);
      }
      for (let x = rr(-6, 6); x < W + gap / 2; x += stride()) {
        raceme(frontLayer, x, lengthAt(x, 1), 1);
      }

      // —— 羽状复叶：挂在藤上，斜垂 ——
      for (let i = 0, n = Math.round(W / 58); i < n; i++) {
        const x = rr(-10, W + 10);
        const y = vineY(x) + 1;
        const L = rr(24, 44);
        const base = rand() > 0.5 ? rr(25, 65) : rr(115, 155);
        const g = add(leafLayer, "g", {
          transform: `translate(${f1(x)} ${f1(y)}) rotate(${f1(base)})`,
        });
        add(g, "path", {
          class: "w-rachis",
          d: `M0 0 Q${f1(L / 2)} 1.5 ${f1(L)} 0`,
        });
        const pairs = Math.round(rr(3, 5));
        for (let k = 1; k <= pairs; k++) {
          const px = (k / (pairs + 0.6)) * L;
          const lr = rr(5.5, 8) * (1 - k / (pairs * 3));
          for (const s of [-1, 1]) {
            add(g, "ellipse", {
              class: (k + (s > 0 ? 1 : 0)) % 2 ? "w-leaf" : "w-leaf2",
              cx: f1(px + lr * 0.55),
              cy: f1(s * lr * 0.5),
              rx: f1(lr),
              ry: f1(lr * 0.36),
              transform: `rotate(${f1(s * rr(38, 55))} ${f1(px)} 0)`,
            });
          }
        }
        add(g, "ellipse", {
          class: "w-leaf",
          cx: f1(L + 5),
          cy: 0,
          rx: 6,
          ry: 2.2,
        });
        leaves.push({
          g,
          x,
          y,
          base,
          phase: rr(0, Math.PI * 2),
          w: rr(0.6, 1.1),
        });
      }

      root.classList.add("is-grown");
    };

    /* ================= 花瓣 ================= */
    const ctx = canvas.getContext("2d");
    let petals: Petal[] = [];
    let colors = ["#9a82c9"];
    let alpha = 1;
    const readColors = () => {
      const cs = getComputedStyle(document.documentElement);
      const list = ["--w1", "--w2", "--w3", "--w4"]
        .map(v => cs.getPropertyValue(v).trim())
        .filter(Boolean);
      if (list.length) colors = list;
      alpha = document.documentElement.dataset.theme === "dark" ? 0.7 : 1;
    };
    const sizeCanvas = () => {
      if (!ctx) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    const spawn = (x?: number, y?: number) => {
      if (petals.length > 22 || !racemes.length) return;
      const r = racemes[Math.floor(Math.random() * racemes.length)];
      petals.push({
        x: x ?? r.x + (Math.random() - 0.5) * 10,
        y: y ?? r.y + r.len * (0.2 + Math.random() * 0.6),
        s: 2.4 + Math.random() * 2.6,
        vy: 0.22 + Math.random() * 0.35,
        sway: Math.random() * Math.PI * 2,
        vs: 0.02 + Math.random() * 0.02,
        rot: Math.random() * Math.PI * 2,
        vr: (Math.random() - 0.5) * 0.04,
        flip: Math.random() * Math.PI,
        vf: 0.04 + Math.random() * 0.05,
        a: 0.55 + Math.random() * 0.35,
        c: colors[Math.floor(Math.random() * colors.length)],
      });
    };
    const drawPetal = (p: Petal) => {
      if (!ctx) return;
      const s = p.s;
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot);
      ctx.scale(Math.max(0.15, Math.abs(Math.cos(p.flip))), 1);
      ctx.globalAlpha = p.a * alpha * Math.max(0, 1 - p.y / (H * 1.05));
      ctx.fillStyle = p.c;
      ctx.beginPath();
      ctx.moveTo(0, -s);
      ctx.bezierCurveTo(s * 0.95, -s * 0.55, s * 0.7, s * 0.85, 0, s);
      ctx.bezierCurveTo(-s * 0.7, s * 0.85, -s * 0.95, -s * 0.55, 0, -s);
      ctx.fill();
      ctx.restore();
    };

    /* ================= 风 ================= */
    let running = false;
    let raf = 0;
    let last = 0;
    let gustAt = -1e9;
    let gustDur = 1;
    let gustPeak = 0;
    let nextGust = 0;
    let nextPetal = 0;

    const frame = (now: number) => {
      if (!running) return;
      const dt = Math.min(3, (now - (last || now)) / 16.67);
      last = now;
      const ts = now / 1000;

      // 隔一阵来一阵风：平滑地起、停
      if (now > nextGust) {
        gustAt = now;
        gustDur = 2400 + Math.random() * 2600;
        gustPeak = 0.55 + Math.random() * 0.6;
        nextGust = now + gustDur + 6000 + Math.random() * 9000;
        for (let i = 0, n = 2 + Math.floor(Math.random() * 4); i < n; i++) {
          setTimeout(() => spawn(), Math.random() * gustDur * 0.8);
        }
      }
      const gp = (now - gustAt) / gustDur;
      const wind =
        gp >= 0 && gp < 1 ? gustPeak * Math.sin(Math.PI * gp) ** 2 : 0;

      // 花穗：弹簧追随「轻摆 + 顺风」的目标角度，可被手指拨动
      for (const r of racemes) {
        const target =
          r.amp * Math.sin(ts * r.w + r.phase) -
          wind * r.gust * (1 + 0.2 * Math.sin(ts * 3.3 + r.phase));
        r.vel += (target - r.angle) * 0.035 * dt;
        r.vel *= Math.pow(0.92, dt);
        r.angle += r.vel * dt;
        r.g.setAttribute(
          "transform",
          `translate(${f1(r.x)} ${f1(r.y)}) rotate(${r.angle.toFixed(2)})`
        );
      }
      for (const l of leaves) {
        const a = l.base + Math.sin(ts * l.w + l.phase) * 2.2 - wind * 6;
        l.g.setAttribute(
          "transform",
          `translate(${f1(l.x)} ${f1(l.y)}) rotate(${f1(a)})`
        );
      }

      if (now > nextPetal) {
        spawn();
        nextPetal = now + 1300 + Math.random() * 1800;
      }
      if (ctx) {
        ctx.clearRect(0, 0, W, H);
        petals = petals.filter(p => p.y < H + 12 && p.x > -12 && p.x < W + 12);
        for (const p of petals) {
          p.sway += p.vs * dt;
          p.x += (Math.sin(p.sway) * 0.35 + wind * 1.4) * dt;
          p.y += p.vy * dt;
          p.rot += p.vr * dt;
          p.flip += p.vf * dt;
          drawPetal(p);
        }
      }
      raf = requestAnimationFrame(frame);
    };

    const start = () => {
      if (running || reduce) return;
      running = true;
      last = 0;
      const now = performance.now();
      if (!nextGust) nextGust = now + 2500 + Math.random() * 3500;
      raf = requestAnimationFrame(frame);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
    };

    build();
    readColors();
    sizeCanvas();
    new MutationObserver(readColors).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    if (reduce) return;

    let visible = true;
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !document.hidden) start();
      else stop();
    }).observe(root);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else if (visible) start();
    });

    // 拨一下：附近的花穗晃动，落一两片花瓣
    const nudge = (x: number, push: number) => {
      for (const r of racemes) {
        const d = Math.abs(r.x - x);
        if (d < 46) r.vel += (push * (1 - d / 46)) / r.depth;
      }
    };
    root.addEventListener(
      "pointerdown",
      e => {
        const b = root.getBoundingClientRect();
        const x = e.clientX - b.left;
        const y = e.clientY - b.top;
        nudge(x, Math.random() > 0.5 ? 1.6 : -1.6);
        for (let i = 0, n = 1 + Math.floor(Math.random() * 3); i < n; i++) {
          spawn(x + (Math.random() - 0.5) * 16, y + (Math.random() - 0.5) * 10);
        }
      },
      { passive: true }
    );
    let lastX: number | null = null;
    root.addEventListener(
      "pointermove",
      e => {
        if (e.pointerType !== "mouse") return;
        const x = e.clientX - root.getBoundingClientRect().left;
        if (lastX !== null) {
          nudge(x, Math.max(-1, Math.min(1, (lastX - x) * 0.05)));
        }
        lastX = x;
      },
      { passive: true }
    );
    root.addEventListener("pointerleave", () => (lastX = null));

    // 宽度变了才重长（手机地址栏伸缩只改高度，不重长）
    let resizeTimer: number | undefined;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        if (Math.abs(root.getBoundingClientRect().width - W) < 2) return;
        build();
        sizeCanvas();
      }, 200);
    });
  }

  initWisteria();
</script>

<style>
  .wisteria {
    position: relative;
    z-index: 0;
    height: 10.5rem;
    margin-bottom: -5rem;
    overflow: hidden;
    touch-action: pan-y;
    -webkit-mask-image: linear-gradient(to bottom, #000 40%, transparent 97%);
    mask-image: linear-gradient(to bottom, #000 40%, transparent 97%);
  }
  @media (width >= 640px) {
    .wisteria {
      /* 电脑端同样铺满整个顶部：两端长、中间短，不挡标题 */
      height: 12.5rem;
      margin-bottom: -5.5rem;
    }
  }
  @media (width >= 1024px) {
    .wisteria {
      height: 14rem;
      margin-bottom: -6rem;
    }
  }
  .wisteria-svg,
  .wisteria-petals {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .wisteria-petals {
    pointer-events: none;
  }
  .wisteria-svg {
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 900ms var(--ease-out),
      transform 1200ms var(--ease-out);
  }
  .wisteria.is-grown .wisteria-svg {
    opacity: 1;
    transform: none;
  }

  .wisteria :global(.w-vine),
  .wisteria :global(.w-vine2),
  .wisteria :global(.w-tendril),
  .wisteria :global(.w-stem),
  .wisteria :global(.w-rachis) {
    fill: none;
    stroke-linecap: round;
  }
  .wisteria :global(.w-vine) {
    stroke: var(--vine);
    stroke-width: 3.2;
    opacity: 0.75;
  }
  .wisteria :global(.w-vine2) {
    stroke: var(--vine);
    stroke-width: 1.4;
    opacity: 0.55;
  }
  .wisteria :global(.w-tendril) {
    stroke: var(--leaf);
    stroke-width: 0.9;
    opacity: 0.6;
  }
  .wisteria :global(.w-stem) {
    stroke: var(--leaf);
    stroke-width: 0.9;
    opacity: 0.5;
  }
  .wisteria :global(.w-rachis) {
    stroke: var(--leaf);
    stroke-width: 0.8;
    opacity: 0.7;
  }
  .wisteria :global(.w-leaf) {
    fill: var(--leaf);
    opacity: 0.75;
  }
  .wisteria :global(.w-leaf2) {
    fill: var(--leaf-2);
    opacity: 0.75;
  }
  .wisteria :global(.w-t0) {
    fill: var(--w0);
