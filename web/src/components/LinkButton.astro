---
import type { HTMLAttributes } from "astro/types";

type Props = { disabled?: boolean } & HTMLAttributes<"a">;

const { disabled, class: className, href, ...attrs } = Astro.props;
---

{
  disabled ? (
    <span aria-disabled="true" class={className} {...attrs}>
      <slot />
    </span>
  ) : (
    <a href={href} class={className} {...attrs}>
      <slot />
    </a>
  )
}
