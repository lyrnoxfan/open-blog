<button class="back-to-top" aria-label="返回顶部" id="backToTop" hidden>
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <polyline points="18 15 12 9 6 15"></polyline>
  </svg>
  <span class="sr-only">返回顶部</span>
</button>

<script is:inline type="module">
  const ID = 'backToTop';
  const offset = 300; // px scrolled before showing button
  const btn = document.getElementById(ID);

  if (btn) {
    const supportsSmooth = 'scrollBehavior' in document.documentElement.style;

    const toggle = () => {
      // Use hidden attribute to avoid layout shifts
      btn.hidden = window.scrollY < offset;
    };

    btn.addEventListener('click', () => {
      if (supportsSmooth) {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        window.scrollTo(0, 0);
      }
    });

    // Initialize and listen to scroll events
    toggle();
    window.addEventListener('scroll', toggle, { passive: true });

    // Clean up on pagehide to avoid potential leaks in SPA contexts
    window.addEventListener('pagehide', () => {
      window.removeEventListener('scroll', toggle);
    });
  }
</script>

<style>
  .back-to-top {
    position: fixed;
    right: 1rem;
    bottom: 1.25rem;
    z-index: 50;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    background: var(--skin-fill, #111827);
    color: var(--skin-inverse, #fff);
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.12);
    cursor: pointer;
    font-size: 14px;
    line-height: 1;
    transition: transform .12s ease, opacity .12s ease;
    border: none;
  }

  .back-to-top[hidden] {
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
  }

  .back-to-top svg {
    width: 18px;
    height: 18px;
  }

  .back-to-top:focus {
    outline: 2px solid rgba(59,130,246,0.6);
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>