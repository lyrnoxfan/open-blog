<button class="back-to-top" aria-label="返回顶部" id="backToTop" hidden>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M12 19V5M6 11l6-6 6 6"></path>
  </svg>
</button>

<script>
  const btn = document.getElementById("backToTop");
  if (btn) {
    const toggle = () => {
      btn.hidden = window.scrollY < 480;
    };
    btn.addEventListener("click", () => {
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
    });
    toggle();
    window.addEventListener("scroll", toggle, { passive: true });
  }
</script>

<style>
  /* 位于 Dock 右上方，避免与 Dock 重叠 */
  .back-to-top {
    position: fixed;
    right: 1rem;
    bottom: calc(var(--dock-h) + 1.75rem + var(--safe-bottom));
    z-index: 39;
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    color: var(--wisteria);
    box-shadow: var(--shadow-md);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition:
      transform var(--dur) var(--ease-out),
      opacity var(--dur) ease;
  }
  .back-to-top:hover {
    transform: translateY(-2px);
  }
  .back-to-top[hidden] {
    display: inline-grid;
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
  }
  .back-to-top svg {
    width: 1.125rem;
    height: 1.125rem;
  }
  @media (width >= 640px) {
    .back-to-top {
      right: 1.5rem;
      bottom: calc(1.5rem + var(--safe-bottom));
    }
  }
</style>
