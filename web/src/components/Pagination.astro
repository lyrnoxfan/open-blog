---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";

type Props = {
  page: Page<CollectionEntry<"blog">>;
};

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav
      class="relative mt-auto mb-8 flex items-center justify-center"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      <LinkButton
        disabled={!page.url.prev}
        href={page.url.prev as string}
        class:list={[
          "me-3 btn-pill btn-pill-hover select-none",
          { "pointer-events-none opacity-40": !page.url.prev },
        ]}
        aria-label="Goto Previous Page"
      >
        <IconArrowLeft class="inline-block rtl:rotate-180" />
        上一页
      </LinkButton>

      {/* --- 页码显示与跳转区域 --- */}
      <div class="relative" id="pagination-container">
        {/* 点击触发器 */}
        <button
          id="page-trigger"
          class="px-3 py-1 mx-2 rounded-full hover:bg-muted transition-colors cursor-pointer font-medium tabular-nums"
          title="点击跳转页面"
        >
          {page.currentPage} / {page.lastPage}
        </button>

        {/* 弹出的输入框 */}
        <div
          id="page-jump-popup"
          class="absolute bottom-full left-1/2 z-50 mb-3 hidden -translate-x-1/2"
        >
          <div class="bg-surface shadow-lg rounded-2xl border border-border p-2 flex items-center gap-2">
            <input
              type="number"
              id="page-input"
              min="1"
              max={page.lastPage}
              placeholder="页码"
              class="w-16 h-8 px-2 text-center border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-accent bg-background text-foreground text-sm"
            />
            <button
              id="page-go"
              class="h-8 px-3 bg-accent text-background rounded-full hover:opacity-90 text-sm font-medium shrink-0"
            >
              GO
            </button>
          </div>
          {/* 小三角箭头 (视觉连接) */}
          <div class="absolute left-1/2 -translate-x-1/2 top-full w-0 h-0 border-x-8 border-x-transparent border-t-8 border-t-surface"></div>
        </div>
      </div>
      {/* --- 结束修改 --- */}

      <LinkButton
        disabled={!page.url.next}
        href={page.url.next as string}
        class:list={[
          "ms-3 btn-pill btn-pill-hover select-none",
          { "pointer-events-none opacity-40": !page.url.next },
        ]}
        aria-label="Goto Next Page"
      >
        下一页
        <IconArrowRight class="inline-block rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}

<script
  define:vars={{
    currentPage: page.currentPage,
    lastPage: page.lastPage,
    firstUrl: page.url.first ?? page.url.current,
  }}
>
  // 初始化分页跳转弹窗。注意：本项目未启用 ClientRouter，
  // `astro:page-load` 在首屏不会触发，因此必须立即执行绑定。
  function initPageJump() {
    const trigger = document.getElementById("page-trigger");
    const popup = document.getElementById("page-jump-popup");
    const input = document.getElementById("page-input");
    const goBtn = document.getElementById("page-go");

    // 元素不存在或已绑定则退出（避免视图过渡时重复绑定）
    if (!trigger || !popup || !input || !goBtn || trigger.dataset.bound) return;
    trigger.dataset.bound = "true";

    // 点击页码数字，显示/隐藏输入框
    trigger.addEventListener("click", e => {
      e.stopPropagation();
      const isHidden = popup.classList.contains("hidden");
      popup.classList.toggle("hidden", !isHidden);

      if (isHidden) {
        input.value = currentPage; // 默认填入当前页
        input.focus();
        input.select();
      }
    });

    // 点击页面其他地方隐藏输入框
    document.addEventListener("click", e => {
      if (!popup.contains(e.target) && e.target !== trigger) {
        popup.classList.add("hidden");
      }
    });

    // 执行跳转逻辑
    const handleJump = () => {
      const targetPage = parseInt(input.value);

      // 校验页码范围
      if (targetPage >= 1 && targetPage <= lastPage) {
        // 跳过当前页
        if (targetPage === currentPage) {
          popup.classList.add("hidden");
          return;
        }

        // --- URL 构造逻辑 ---
        // firstUrl 由构建时传入：第 1 页为 /posts/ 这类首页路径
        let base = firstUrl || "/posts";
        if (base.endsWith("/")) {
          base = base.slice(0, -1);
        }

        let targetUrl = "";
        if (targetPage === 1) {
          // 第1页回到列表首页，即 /posts/
          targetUrl = base + "/";
        } else {
          // 第N页：/posts/2/
          targetUrl = `${base}/${targetPage}/`;
        }

        // 执行跳转
        window.location.href = targetUrl;
      } else {
        // 错误抖动提示
        input.classList.add("ring-2", "ring-red-500", "border-red-500");
        setTimeout(() => {
          input.classList.remove("ring-2", "ring-red-500", "border-red-500");
        }, 800);
      }
    };

    // 绑定按钮点击
    goBtn.addEventListener("click", handleJump);

    // 绑定回车键
    input.addEventListener("keydown", e => {
      if (e.key === "Enter") {
        handleJump();
      }
    });
  }

  // 首屏直接初始化；若将来启用视图过渡，也在每次页面加载后初始化
  initPageJump();
  document.addEventListener("astro:page-load", initPageJump);
</script>
