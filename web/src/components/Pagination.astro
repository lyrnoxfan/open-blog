---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";

type Props = {
  page: Page<CollectionEntry<"blog">>;
};

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav class="mt-10 flex items-center justify-center gap-2" aria-label="分页">
      <LinkButton
        disabled={!page.url.prev}
        href={page.url.prev as string}
        class="btn px-4 select-none"
        aria-label="上一页"
      >
        <IconArrowLeft class="size-4 rtl:rotate-180" aria-hidden="true" />
        <span class="max-[360px]:sr-only">上一页</span>
      </LinkButton>

      <div class="relative" id="pagination-container">
        <button
          id="page-trigger"
          class="inline-flex min-h-11 items-center rounded-full px-4 font-serif text-[0.9375rem] text-ink-soft tabular-nums transition-colors hover:bg-paper-deep hover:text-ink"
          title="跳转到指定页"
          aria-haspopup="dialog"
        >
          <span class="text-ink">{page.currentPage}</span>
          <span class="mx-1.5 text-ink-faint">/</span>
          {page.lastPage}
        </button>

        <div
          id="page-jump-popup"
          class="absolute bottom-full left-1/2 z-50 mb-3 hidden -translate-x-1/2"
        >
          <div class="flex items-center gap-2 rounded-2xl border border-rule bg-surface p-2 shadow-[var(--shadow-lg)]">
            <label for="page-input" class="sr-only">
              页码
            </label>
            <input
              type="number"
              id="page-input"
              min="1"
              max={page.lastPage}
              placeholder="页码"
              inputmode="numeric"
              class="h-9 w-16 px-2 text-center text-sm"
            />
            <button
              id="page-go"
              class="h-9 shrink-0 rounded-full bg-wisteria px-4 text-sm font-medium text-paper transition-colors hover:bg-wisteria-deep"
            >
              前往
            </button>
          </div>
        </div>
      </div>

      <LinkButton
        disabled={!page.url.next}
        href={page.url.next as string}
        class="btn px-4 select-none"
        aria-label="下一页"
      >
        <span class="max-[360px]:sr-only">下一页</span>
        <IconArrowRight class="size-4 rtl:rotate-180" aria-hidden="true" />
      </LinkButton>
    </nav>
  )
}

<script
  is:inline
  define:vars={{
    currentPage: page.currentPage,
    lastPage: page.lastPage,
    firstUrl: page.url.first ?? page.url.current,
  }}
>
  // 初始化分页跳转弹窗。注意：本项目未启用 ClientRouter，
  // `astro:page-load` 在首屏不会触发，因此必须立即执行绑定。
  function initPageJump() {
    const trigger = document.getElementById("page-trigger");
    const popup = document.getElementById("page-jump-popup");
    const input = document.getElementById("page-input");
    const goBtn = document.getElementById("page-go");

    // 元素不存在或已绑定则退出（避免视图过渡时重复绑定）
    if (!trigger || !popup || !input || !goBtn || trigger.dataset.bound) return;
    trigger.dataset.bound = "true";

    // 点击页码数字，显示/隐藏输入框
    trigger.addEventListener("click", e => {
      e.stopPropagation();
      const isHidden = popup.classList.contains("hidden");
      popup.classList.toggle("hidden", !isHidden);

      if (isHidden) {
        input.value = currentPage; // 默认填入当前页
        input.focus();
        input.select();
      }
    });

    // 点击页面其他地方隐藏输入框
    document.addEventListener("click", e => {
      if (!popup.contains(e.target) && e.target !== trigger) {
        popup.classList.add("hidden");
      }
    });

    // 执行跳转逻辑
    const handleJump = () => {
      const targetPage = parseInt(input.value);

      // 校验页码范围
      if (targetPage >= 1 && targetPage <= lastPage) {
        // 跳过当前页
        if (targetPage === currentPage) {
          popup.classList.add("hidden");
          return;
        }

        // --- URL 构造逻辑 ---
        // firstUrl 由构建时传入：第 1 页为 /posts/ 这类首页路径
        let base = firstUrl || "/posts";
        if (base.endsWith("/")) {
          base = base.slice(0, -1);
        }

        let targetUrl = "";
        if (targetPage === 1) {
          // 第1页回到列表首页，即 /posts/
          targetUrl = base + "/";
        } else {
          // 第N页：/posts/2/
          targetUrl = `${base}/${targetPage}/`;
        }

        // 执行跳转
        window.location.href = targetUrl;
      } else {
        // 错误抖动提示
        input.setAttribute("aria-invalid", "true");
        setTimeout(() => {
          input.removeAttribute("aria-invalid");
        }, 800);
      }
    };

    // 绑定按钮点击
    goBtn.addEventListener("click", handleJump);

    // 绑定回车键
    input.addEventListener("keydown", e => {
      if (e.key === "Enter") {
        handleJump();
      }
    });
  }

  // 首屏直接初始化；若将来启用视图过渡，也在每次页面加载后初始化
  initPageJump();
  document.addEventListener("astro:page-load", initPageJump);
</script>
