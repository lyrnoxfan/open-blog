---
import { getCollection } from "astro:content";
import { countWords } from "@/utils/countWords";

type Props = { class?: string };
const { class: className = "" } = Astro.props;

// 构建时统计：每次构建（新增/更新文章后）都会重新计算
const posts = await getCollection("blog", ({ data }) => !data.draft);
const totalWords = posts.reduce(
  (sum, post) => sum + countWords(post.body ?? ""),
  0
);
---

<p id="site-stats" class:list={["text-sm text-ink-soft", className]}>
  已写下
  <span class="font-serif font-semibold text-seal tabular-nums"
    >{totalWords.toLocaleString("zh-CN")}</span
  >
  字 · <span class="tabular-nums">{posts.length}</span> 篇
</p>
